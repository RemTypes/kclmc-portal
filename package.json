{
  "name": "kclmc-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:worker": "opennextjs-cloudflare build",
    "deploy:cloudflare": "opennextjs-cloudflare build && wrangler deploy",
    "deploy:preview": "opennextjs-cloudflare build && wrangler deploy --env preview",
    "d1:local:migrate": "wrangler d1 execute kclmc-db-preview --local --file=migrations/0001_d1_initial_schema.sql && wrangler d1 execute kclmc-db-preview --local --file=migrations/0002_d1_seed_from_supabase.sql",
    "d1:remote:migrate": "wrangler d1 execute kclmc-db-preview --remote --file=migrations/0001_d1_initial_schema.sql -y && wrangler d1 execute kclmc-db-preview --remote --file=migrations/0002_d1_seed_from_supabase.sql -y",
    "migrate:d1": "tsx scripts/migrate_supabase_to_d1.ts",
    "backup": "tsx scripts/backup_database.ts",
    "test": "vitest run",
    "test:security": "vitest run tests/security.test.ts",
    "test:watch": "vitest",
    "test:email": "tsx scripts/verify_email_system.ts",
    "test:all": "vitest run && npm run test:email",
    "start": "next start",
    "lint": "next lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "@types/qrcode.react": "^1.0.5",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.137.0"
  }
}
