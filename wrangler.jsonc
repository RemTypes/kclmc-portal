{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kclmc-portal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kclmc-production",
      "database_id": "25583bc2-683b-49ac-a5c0-2419a66f651a"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
