# ==============================================================================
# King's College London Mountaineering Club (KCLMC) Platform
# Production Environment Configuration Template (sample.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local for local development:
#    cp sample.env .env.local
# 2. For Cloudflare production deployment:
#    Configure these keys in Cloudflare Dashboard -> Workers & Pages -> Settings -> Variables and Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Canonical URL & Hostname
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://kclmc.org

# ------------------------------------------------------------------------------
# 2. Supabase Public Client Credentials (Safe to expose to browser)
# ------------------------------------------------------------------------------
# Obtained from: Supabase Project Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# 3. Supabase Server & Admin Credentials (STRICTLY CONFIDENTIAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
# Used exclusively server-side for admin roster sync, pass issuance, and backups.
# NEVER import or reference in client components ('use client').
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 4. PostgreSQL Connection Pooling (Supavisor Port 6543)
# ------------------------------------------------------------------------------
# For serverless Edge & Cloudflare Workers, API routes communicate over pooled HTTPS PostgREST.
# Direct database connections (Prisma, Drizzle, migrations, backups) MUST connect via
# the Transaction Pooler (port 6543) to prevent connection exhaustion.
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true

# ------------------------------------------------------------------------------
# 5. Payment Provider & Stripe Keys (SET TO LIVE FOR PRODUCTION)
# ------------------------------------------------------------------------------
# WARNING: Test keys (sk_test_..., pk_test_...) are strictly blocked in production.
# Only live keys (sk_live_..., pk_live_...) are permitted.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 6. Role-Based Access Control (RBAC) Whitelists
# ------------------------------------------------------------------------------
# Primary system super-administrator (Role 2)
SUPERADMIN_EMAIL=admin@kclmc.org

# Comma-separated list of official committee officer email addresses (Role 1)
# Members with these emails automatically receive committee administrative privileges.
COMMITTEE_EMAILS=president@kclmc.org,treasurer@kclmc.org,gear@kclmc.org,trips@kclmc.org,social@kclmc.org,portal@kclmc.org

# ------------------------------------------------------------------------------
# 7. Email Delivery & Custom Sender Domain (Gmail or Purelymail custom domain)
# ------------------------------------------------------------------------------
# Option A: Custom Sender Domain via Purelymail (Official society domain kclmc.org):
# SMTP_HOST=smtp.purelymail.com
# SMTP_PORT=465
# SMTP_USER=committee@kclmc.org
# SMTP_PASS=your-purelymail-app-password
# SMTP_FROM="King's College London Mountaineering Club" <committee@kclmc.org>

# Option B: Google Workspace / Gmail Relay:
GMAIL_USER=kclmc.committee@gmail.com
GMAIL_APP_PASS=your-16-character-google-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM="King's College London Mountaineering Club" <kclmc.committee@gmail.com>

# ------------------------------------------------------------------------------
# 8. WhatsApp Official Members Community (Hidden Gateway)
# ------------------------------------------------------------------------------
# Secret groupchat link kept strictly server-side (never exposed with NEXT_PUBLIC_)
WHATSAPP_COMMUNITY_INVITE_URL=https://chat.whatsapp.com/CPVH7dfM88QCGuFYyLcrDF?mode=gi_t

# ------------------------------------------------------------------------------
# 9. Error Monitoring & Telemetry Alerts
# ------------------------------------------------------------------------------
# Optional Sentry DSN or Discord/Slack/OpsGenie Webhook for critical error notifications:
# NEXT_PUBLIC_SENTRY_DSN=https://example@sentry.io/12345
# ERROR_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# ------------------------------------------------------------------------------
# 10. AI Spending Cap & Safety Guard
# ------------------------------------------------------------------------------
# Hard monetary caps protecting society funds against runaway API costs:
AI_MONTHLY_SPENDING_CAP_USD=10.00
AI_DAILY_SPENDING_CAP_USD=1.00
AI_MAX_TOKENS_PER_REQUEST=4000
AI_EMERGENCY_KILLSWITCH=false
