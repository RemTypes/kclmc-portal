# ==============================================================================
# King's College London Mountaineering Club (KCLMC) Platform
# Environment Configuration Template (sample.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local for local development:
#    cp sample.env .env.local
# 2. For Cloudflare production deployment:
#    Configure these keys in Cloudflare Dashboard -> Workers & Pages -> Settings -> Variables and Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Public Client Credentials (Safe to expose to browser)
# ------------------------------------------------------------------------------
# Obtained from: Supabase Project Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------------------------
# 2. Supabase Server & Admin Credentials (STRICTLY CONFIDENTIAL - NEVER COMMIT)
# ------------------------------------------------------------------------------
# Used exclusively server-side for admin roster sync, pass issuance, and GDPR backups.
# NEVER import or reference in client components ('use client').
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 3. Role-Based Access Control (RBAC) Whitelists
# ------------------------------------------------------------------------------
# Primary system super-administrator (Role 2)
SUPERADMIN_EMAIL=admin@kclmc.org

# Comma-separated list of official committee officer email addresses (Role 1)
# Members with these emails automatically receive committee administrative privileges.
COMMITTEE_EMAILS=president@kclmc.org,treasurer@kclmc.org,gear@kclmc.org,trips@kclmc.org,social@kclmc.org,portal@kclmc.org

# ------------------------------------------------------------------------------
# 4. Email Delivery & SMTP Configuration (Gmail or Purelymail)
# ------------------------------------------------------------------------------
# For Gmail (Recommended):
GMAIL_USER=kclmc.committee@gmail.com
GMAIL_APP_PASS=your-16-character-google-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM="King's College London Mountaineering Club" <kclmc.committee@gmail.com>

# Or for Purelymail:
# SMTP_HOST=smtp.purelymail.com
# SMTP_PORT=465
# SMTP_USER=committee@kclmc.org
# SMTP_PASS=your-purelymail-app-password
# SMTP_FROM=King's College London Mountaineering Club <committee@kclmc.org>

# ------------------------------------------------------------------------------
# 5. WhatsApp Official Members Community (Hidden Gateway)
# ------------------------------------------------------------------------------
# Secret groupchat link kept strictly server-side (never exposed with NEXT_PUBLIC_)
WHATSAPP_COMMUNITY_INVITE_URL=https://chat.whatsapp.com/CPVH7dfM88QCGuFYyLcrDF?mode=gi_t
